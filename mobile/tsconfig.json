{
  "extends": "expo/tsconfig.base",
  "compilerOptions": {
    "strict": true,
    "allowUnusedLabels": false,
    "noFallthroughCasesInSwitch": true,
    "noUnusedLocals": true,
    "noImplicitAny": true,
    "noUnusedParameters": true,
    "noUncheckedIndexedAccess": true,
    "useUnknownInCatchVariables": true,
    "paths": {
      "@/*": [
        "./src/*",
      ],
      "root/*": [
        "./*"
      ],
    }
  },
  "include": [
    "src/**/*.ts", 
    "src/**/*.tsx",
    ".expo/types/**/*.ts",
    "expo-env.d.ts",
    "nativewind-env.d.ts",
    "declarations.d.ts"
  ]
}